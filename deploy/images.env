# BBB Demo image manifest — source of truth for exact deployed versions.
#
# Each ref is an immutable GHCR image tagged with the full Git commit SHA
# it was built from. Update via a normal PR after a service's CI has
# published a new image on main. Do not point these at `:main` or `:latest`.
MDS_IMAGE=ghcr.io/roman-vyl/market_data_service:REPLACE_WITH_SHA
STRATEGY_ENGINE_IMAGE=ghcr.io/roman-vyl/strategy_engine:REPLACE_WITH_SHA
STRATEGY_RUNTIME_IMAGE=ghcr.io/roman-vyl/strategy_runtime:REPLACE_WITH_SHA
ABI_IMAGE=ghcr.io/roman-vyl/abi_executor_bot:REPLACE_WITH_SHA
